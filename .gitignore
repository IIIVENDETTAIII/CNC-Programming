# ========================================
# CNC Programming Project - .gitignore
# ========================================

# ===== Windows =====
# Windows thumbnail cache files
Thumbs.db
Thumbs.db:encryptable
ehthumbs.db
ehthumbs_vista.db

# Windows shortcuts
*.lnk

# Windows folder config file
[Dd]esktop.ini

# Recycle Bin used on file shares
$RECYCLE.BIN/

# Windows Installer files
*.cab
*.msi
*.msix
*.msm
*.msp

# ===== MasterCam =====
# MasterCam backup files
*.BAK
*.bak

# MasterCam temporary files
*.tmp
*.temp
*.$$$

# ===== CNC Simulator =====
# SSCNC Simulator temporary files
*.sscnc-tmp
*.sim

# ===== Office Files =====
# Excel temporary files
~$*.xls*
*.xlk

# Word temporary files
~$*.doc*
*.wbk

# PowerPoint temporary files
~$*.ppt*

# Office Temp Files
*.tmp

# ===== Backup Files =====
# General backups
*~
*.bak
*.backup
*.old
*.orig

# ===== Logs and Databases =====
*.log
*.sql
*.sqlite
*.db

# ===== Compressed Archives =====
*.zip
*.rar
*.7z
*.tar
*.gz

# ===== IDE and Editors =====
# Visual Studio Code
.vscode/
!.vscode/settings.json
!.vscode/tasks.json
!.vscode/launch.json
!.vscode/extensions.json
*.code-workspace

# Notepad++ backup
*.bak

# Sublime Text
*.sublime-workspace
*.sublime-project

# ===== macOS =====
.DS_Store
.AppleDouble
.LSOverride

# ===== Personal Files =====
# Personal notes that shouldn't be shared
*PRIVATE*
*private*
*Personal*
*personal*

# ===== Large Binary Files =====
# Videos (if any)
*.mp4
*.avi
*.mov
*.mkv

# Audio files
*.mp3
*.wav
*.m4a

# ===== Git =====
*.orig